# ===========================================================================
# NanoBio Studio — environment variables
# ===========================================================================
# Copy to `.env` and replace every placeholder. `.env` is git-ignored and never
# travels in a source archive.
#
# Every value below is a SAFE PLACEHOLDER. None is a working credential, and
# none should be used as-is in any deployment.
# ===========================================================================

# --- Backend: databases ----------------------------------------------------
# Auth, workspace and report tables. SQLite locally, PostgreSQL in deployment;
# only the URL changes.
AUTH_DATABASE_URL=sqlite+aiosqlite:///./nanobio_auth_dev.db
# Production form:
#   postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DB

# To inspect the shipped sample data instead, point at the sanitized file:
#   AUTH_DATABASE_URL=sqlite+aiosqlite:///./nanobio_SAMPLE_DEV_DATABASE_DO_NOT_USE_IN_PRODUCTION.db

# Legacy LNP backend database. Deliberately separate from AUTH_DATABASE_URL, so
# pointing one at PostgreSQL does not implicitly move the other.
DATABASE_URL=sqlite+aiosqlite:///./nanobio_lnp_dev.db

# --- Backend: session cookie ----------------------------------------------
# MUST be true behind HTTPS. false only for plain-HTTP local development.
SESSION_COOKIE_SECURE=false

# --- Backend: serving the built frontend ----------------------------------
# When true, FastAPI serves frontend/dist from the same origin as the API.
# Same-origin is required: the session cookie is SameSite=Lax, so a cross-site
# API call is accepted at login and then never sent again.
SERVE_FRONTEND=false

# --- Backend: application ---------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
# Only needed for a cross-origin deployment. Inert when SERVE_FRONTEND=true.
CORS_ORIGINS=["http://127.0.0.1:5173"]

# --- Frontend ---------------------------------------------------------------
# EMPTY means same-origin, which is the correct and supported setting. Set an
# absolute URL only if the API genuinely lives on another origin — which also
# requires SameSite=None; Secure on the cookie, and HTTPS on both.
VITE_API_BASE_URL=

# --- Administrator bootstrap (never hard-code) ------------------------------
# Read by nanobio_studio_backend/scripts/create_admin.py in non-interactive
# mode. Choose your own value and unset it afterwards.
NANOBIO_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

# --- Browser walkthrough scripts -------------------------------------------
# Password for the throwaway account the Playwright walkthroughs sign in with.
NANOBIO_TEST_PASSWORD=REPLACE_WITH_A_THROWAWAY_TEST_PASSWORD
