# Base URL for API requests.
#
# Leave EMPTY for same-origin requests. The dev server proxies /api, /health and
# /ready to the backend (see vite.config.ts), so the browser only ever talks to
# the origin it loaded the page from — which is what keeps the SameSite=Lax
# session cookie working at localhost, 127.0.0.1 or a LAN address alike.
#
# Set an absolute URL only when the API genuinely lives on another origin, which
# additionally requires SameSite=None; Secure on the cookie and HTTPS on both.
VITE_API_BASE_URL=

# Backend the dev server proxies to. Only the proxy target — never sent to the
# browser. Defaults to http://127.0.0.1:8000.
# VITE_PROXY_TARGET=http://127.0.0.1:8000
