# NanoBio Studio Backend Environment Configuration
# Copy this to .env and fill in your values

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DATABASE_URL=postgresql+psycopg://nanobio_user:changeme@localhost:5432/nanobio_studio_db

# ============================================================
# API CONFIGURATION
# ============================================================
API_TITLE=NanoBio Studio Backend API
API_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO

# ============================================================
# SECURITY (future use)
# ============================================================
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256

# ============================================================
# APPLICATION
# ============================================================
APP_NAME=nanobio_studio
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501","*"]

# ============================================================
# OBJECT STORAGE
# ============================================================
# PLACEHOLDERS ONLY. Every value below is a shape, not a secret.
#
# A committed example file containing a real endpoint is nearly as bad as one
# containing a real key: it names the account and the bucket to go after, and
# it is the file people copy without reading.
#
# One driver speaks to AWS S3, Cloudflare R2, MinIO and every other
# S3-compatible service. What differs between providers is the endpoint, the
# region and whether path-style addressing is needed — three settings, not
# three code paths.
#
#   local  filesystem. DEVELOPMENT ONLY: unencrypted bytes in a directory,
#          no lifecycle policy, no replication.
#   s3     any S3-compatible service.
STORAGE_DRIVER=local

# Local driver only. Relative paths resolve against the working directory.
STORAGE_LOCAL_ROOT=var/attachments

# --- s3 driver ----------------------------------------------------------
# Required when STORAGE_DRIVER=s3. The application refuses to start without a
# bucket rather than falling back to local storage: silently writing to a
# container filesystem when object storage was asked for is how files are lost
# on the next deploy.
STORAGE_BUCKET=your-bucket-name

# Leave EMPTY for AWS S3. Set it for anything else:
#   Cloudflare R2   https://<account-id>.r2.cloudflarestorage.com
#   MinIO           http://minio.internal:9000
#   Other gateway   https://objects.example.internal
STORAGE_ENDPOINT_URL=

# AWS uses a real region; R2 uses "auto"; MinIO ignores it.
STORAGE_REGION=us-east-1

# Omit BOTH to use the ambient credential chain — an instance role, a workload
# identity or a mounted credentials file. Prefer that to a long-lived key in
# the environment wherever the platform offers it.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# MinIO and most self-hosted gateways need path-style addressing, because
# virtual-host addressing requires wildcard DNS a private deployment rarely
# has.
STORAGE_PATH_STYLE=false

# Optional key prefix, for a bucket shared with something else.
STORAGE_PREFIX=

# Server-side encryption. "AES256" is provider-managed and works on AWS and
# most compatible gateways; R2 and MinIO encrypt at rest regardless.
STORAGE_SSE=AES256

# Customer-managed key. A key *identifier*, so this is not tied to one cloud's
# key-management product. Empty means provider-managed encryption.
STORAGE_SSE_KMS_KEY_ID=

# Presigned URL lifetime, in seconds. Nothing issues one today — attachments
# and medical-report documents are streamed through the authenticated API,
# because a presigned URL is a bearer credential that outlives the
# authorization that produced it. Kept short so enabling presigned delivery
# later is a decision rather than an accident of a default.
STORAGE_PRESIGNED_TTL_SECONDS=300

# Upload ceiling, in bytes. Enforced before anything is written.
STORAGE_MAX_UPLOAD_BYTES=26214400

# Malware scanning. Leave false unless a scanner is genuinely connected: the
# API then reports "not scanned" rather than "clean". A platform that claims
# scanning it does not perform is worse than one that admits it, because the
# claim is what stops anybody connecting a scanner.
STORAGE_MALWARE_SCANNING_ENABLED=false
STORAGE_MALWARE_SCANNER=

# ============================================================
# INVITATION DELIVERY
# ============================================================
#   recorded (default)  sends nothing; the one-time link is returned to the
#                       administrator to pass on themselves
#   console             writes the link to the log. DEVELOPMENT ONLY: a log
#                       line containing a redemption link is a credential in
#                       a log.
#   smtp                reads every connection detail from below
INVITATION_DELIVERY=recorded
INVITATION_LINK_BASE=/invitations/accept
INVITATION_TTL_HOURS=72

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
